# Optional. Without this, food text search falls back to USDA's shared
# DEMO_KEY, which is tightly rate-limited. Get a free key in seconds at
# https://fdc.nal.usda.gov/api-key-signup and put it in a local .env file
# (already gitignored) as:
VITE_USDA_API_KEY=

# Optional. Elite works entirely offline/local without these — set both to
# also sync to a self-hosted server (see server/ and the Dockerfile). Point
# VITE_API_URL at wherever that server is reachable, and set VITE_SYNC_TOKEN
# to match the server's SYNC_TOKEN if you configured one.
VITE_API_URL=
VITE_SYNC_TOKEN=
