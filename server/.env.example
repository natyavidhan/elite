# Copy to .env for local/bare-metal runs (loaded automatically on startup).
# The Docker deployment doesn't use this file — pass these as real
# environment variables to `docker run`/`docker compose` instead.

# Optional. Enables the AI Coach feature (backend-only — see server/coach/).
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional shared-secret token protecting /api/sync and /api/coach/*.
SYNC_TOKEN=

# PORT=8080
# DATA_DIR=./data
