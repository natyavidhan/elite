# Copy to .env for local/bare-metal runs (loaded automatically on startup).
# The Docker deployment doesn't use this file — pass these as real
# environment variables to `docker run`/`docker compose` instead.

# --- AI Coach (optional, backend-only) ---
# Works with any OpenAI-compatible chat-completions API that supports tool
# calling. COACH_PROVIDER picks a known-good preset for the base URL/model;
# override either individually with COACH_BASE_URL/COACH_MODEL for a
# different model on the same provider, or an entirely different provider.
#
# COACH_PROVIDER=groq        # https://console.groq.com/keys — free tier caps around 8000 tokens/min
# COACH_PROVIDER=opencode    # https://opencode.ai — "-free" model suffixes cost nothing
COACH_PROVIDER=opencode
COACH_API_KEY=
# COACH_BASE_URL=https://opencode.ai/zen/v1
# COACH_MODEL=deepseek-v4-flash-free

# Optional shared-secret token protecting /api/sync and /api/coach/*.
SYNC_TOKEN=

# PORT=8080
# DATA_DIR=./data
