{
  "expo": {
    "name": "Elite",
    "slug": "elite",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "elite",
    "splash": {
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.elite.fitness"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121212"
      },
      "package": "com.elite.fitness"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-barcode-scanner"
    ]
  }
}
